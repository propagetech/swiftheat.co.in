# Internal working material, not part of the site.
# Research, pricing reasoning and the internal quotation live in docs/ in the
# working folder and are deliberately kept out of the repository while it is
# public. Same principle as client-communication/ in the motorover repo.
docs/

# Client deliveries land here before they are sorted into docs/. They carry
# statutory documents (PAN, GST, Udyam and ISO certificates), and the repo root
# is what Cloudflare Pages serves, so nothing in here may be committed.
anotherpptanddocuments/

# macOS
.DS_Store

# Secrets and credentials, never commit any of these
.env
.env.*

# Test dependencies
tests/node_modules/

# Python bytecode
__pycache__/
*.pyc
